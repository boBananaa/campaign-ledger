local WorldScope = (function()
-- Shared opt-in belongs to a saved place. Plugin installation remains per editor.
local WorldScope = {}
WorldScope.enabledAttribute = "CampaignLedgerEnabled"
WorldScope.placeAttribute = "CampaignLedgerPlaceId"

function WorldScope.matches(placeId, enabled, assignedPlaceId)
 return type(placeId) == "number" and placeId &gt; 0 and placeId &lt; math.huge and placeId % 1 == 0
  and enabled == true and type(assignedPlaceId) == "number" and assignedPlaceId == placeId
end

function WorldScope.isEnabled()
 local shared = game:GetService("ReplicatedStorage")
 return WorldScope.matches(game.PlaceId, shared:GetAttribute(WorldScope.enabledAttribute), shared:GetAttribute(WorldScope.placeAttribute))
end

function WorldScope.setEnabled(plugin, enabled)
 if game:GetService("RunService"):IsRunning() then return false, "Stop Play mode before changing the D&amp;D world setting." end
 if not WorldScope.matches(game.PlaceId, true, game.PlaceId) then
  return false, "Save this place to Roblox first, then enable D&amp;D here."
 end
 local history, shared = game:GetService("ChangeHistoryService"), game:GetService("ReplicatedStorage")
 local recording = history:TryBeginRecording(enabled and "Enable D&amp;D in this world" or "Disable D&amp;D in this world")
 if not recording then return false, "Finish the current Studio edit, then try again." end
 local oldEnabled, oldPlace = shared:GetAttribute(WorldScope.enabledAttribute), shared:GetAttribute(WorldScope.placeAttribute)
 local ok, message = pcall(function()
  if enabled then shared:SetAttribute(WorldScope.placeAttribute, game.PlaceId) end
  shared:SetAttribute(WorldScope.enabledAttribute, enabled == true)
 end)
 if not ok then
  shared:SetAttribute(WorldScope.placeAttribute, oldPlace)
  shared:SetAttribute(WorldScope.enabledAttribute, oldEnabled)
 end
 history:FinishRecording(recording, ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
 return ok, message
end

-- Changes can arrive from another Team Create editor or Undo. Coalesce both attributes
-- so activation never runs in the middle of the enable/disable undo recording.
function WorldScope.watch(callback)
 local shared = game:GetService("ReplicatedStorage")
 local alive, queued, previous = true, false, nil
 local function update()
  if not alive then return end
  local enabled = WorldScope.isEnabled()
  if enabled ~= previous then previous = enabled; callback(enabled) end
 end
 local function schedule()
  if queued or not alive then return end
  queued = true
  task.defer(function() queued = false; update() end)
 end
 local connections = {
  shared:GetAttributeChangedSignal(WorldScope.enabledAttribute):Connect(schedule),
  shared:GetAttributeChangedSignal(WorldScope.placeAttribute):Connect(schedule),
  game:GetPropertyChangedSignal("PlaceId"):Connect(schedule),
 }
 update()
 return function()
  alive = false
  for _, connection in ipairs(connections) do connection:Disconnect() end
 end
end

-- Studio reserves toolbar/action IDs for the plugin lifetime even after Destroy.
-- Reuse native handles across world toggles; pause their buttons and clear content.
local resources = {}
local function owned(plugin)
 if not resources[plugin] then resources[plugin] = { toolbars = {}, buttons = {}, widgets = {}, actions = {} } end
 return resources[plugin]
end
function WorldScope.toolbar(plugin, name)
 local r = owned(plugin)
 if not r.toolbars[name] then
  r.toolbars[name] = plugin:CreateToolbar(name)
  r.buttons[r.toolbars[name]] = {}
 end
 return r.toolbars[name]
end
function WorldScope.button(plugin, toolbar, id, tooltip, icon, text)
 local buttons = owned(plugin).buttons[toolbar]
 if not buttons[id] then buttons[id] = toolbar:CreateButton(id, tooltip, icon, text) end
 buttons[id].Enabled = true
 return buttons[id]
end
function WorldScope.pauseToolbar(plugin, toolbar)
 for _, button in pairs(owned(plugin).buttons[toolbar]) do button:SetActive(false); button.Enabled = false end
end
function WorldScope.widget(plugin, id, info)
 local r = owned(plugin)
 if not r.widgets[id] then r.widgets[id] = plugin:CreateDockWidgetPluginGuiAsync(id, info) end
 r.widgets[id].Enabled = false
 return r.widgets[id]
end
function WorldScope.action(plugin, id, title, description, icon, allowBinding)
 local actions = owned(plugin).actions
 if not actions[id] then actions[id] = plugin:CreatePluginAction(id, title, description, icon, allowBinding) end
 return actions[id]
end
local function dispose(plugin)
 local r = resources[plugin]
 if not r then return end
 for _, widget in pairs(r.widgets) do widget:Destroy() end
 for _, action in pairs(r.actions) do action:Destroy() end
 for _, buttons in pairs(r.buttons) do for _, button in pairs(buttons) do button:Destroy() end end
 for _, toolbar in pairs(r.toolbars) do toolbar:Destroy() end
 resources[plugin] = nil
end

-- A session owns its widgets, hover viewer and listeners. Unmarked places get none.
function WorldScope.run(plugin, startSession)
 local stopSession, alive = nil, true
 local function stop()
  if stopSession then local cleanup = stopSession; stopSession = nil; cleanup() end
 end
 local stopWatching = WorldScope.watch(function(enabled)
  if not alive then return end
  if enabled and not stopSession then stopSession = startSession() elseif not enabled then stop() end
 end)
 local unloading
 local function destroy()
  if not alive then return end
  alive = false
  stopWatching(); stop(); dispose(plugin)
  if unloading then unloading:Disconnect() end
 end
 unloading = plugin.Unloading:Connect(destroy)
 return destroy
end
return WorldScope

end)()

local State = (function()
-- Pure combat rules; no Roblox services or UI dependencies.
local State = {}
State.resources = { "hp", "mana", "ap" }
State.labels = { hp = "Health", mana = "Mana", ap = "Actions" }
State.limit = 9999

function State.integer(value: any): number?
	local number = tonumber(value)
	if not number or number ~= number or math.abs(number) == math.huge or number % 1 ~= 0 then
		return nil
	end
	return number
end

function State.default(name)
	return {
		version = 1, name = name, showPlate = true, autoName = true, plateOffset = 0,
		hp = { current = 100, maximum = 100 },
		mana = { current = 125, maximum = 125 },
		ap = { current = 6, maximum = 6 },
	}
end

function State.validate(state: any)
	if type(state) ~= "table" or state.version ~= 1 then
		return false, "Unsupported or missing character stats."
	end
	if type(state.name) ~= "string" or #state.name == 0 or #state.name &gt; 192 then
		return false, "Character name must contain 1–48 characters."
	end
	local nameLength = utf8.len(state.name)
	if not nameLength or nameLength &gt; 48 or state.name:find("[%c]") then
		return false, "Character name must contain 1–48 characters without line breaks."
	end
	if type(state.showPlate) ~= "boolean" then
		return false, "Invalid plate visibility."
	end
	if state.autoName ~= nil and type(state.autoName) ~= "boolean" then
		return false, "Invalid automatic name setting."
	end
	if state.plateOffset ~= nil and (type(state.plateOffset) ~= "number" or state.plateOffset ~= state.plateOffset
		or state.plateOffset &lt; -3 or state.plateOffset &gt; 10) then return false, "Invalid plate height." end
	for _, key in ipairs(State.resources) do
		local resource = state[key]
		if type(resource) ~= "table" then
			return false, "Missing " .. State.labels[key] .. " stats."
		end
		local current, maximum = State.integer(resource.current), State.integer(resource.maximum)
		if type(resource.current) ~= "number" or type(resource.maximum) ~= "number"
			or not current or not maximum or maximum &lt; 0 or maximum &gt; State.limit
			or current &lt; 0 or current &gt; maximum then
			return false, "Invalid " .. State.labels[key] .. " values."
		end
	end
	return true
end

function State.copy(state)
	local result = { version = 1, name = state.name, showPlate = state.showPlate,
		autoName = state.autoName ~= false, plateOffset = state.plateOffset or 0 }
	for _, key in ipairs(State.resources) do
		result[key] = { current = state[key].current, maximum = state[key].maximum }
	end
	return result
end

function State.setResource(state, key, currentValue, maximumValue)
	if not State.labels[key] then return nil, "Unknown resource." end
	local current, maximum = State.integer(currentValue), State.integer(maximumValue)
	if current == nil or maximum == nil then return nil, "Enter whole numbers for both values." end
	if maximum &lt; 0 or maximum &gt; State.limit then return nil, "Maximum must be 0–9999." end
	if current &lt; 0 or current &gt; State.limit then return nil, "Current must be 0–9999." end
	local result = State.copy(state)
	result[key] = { current = math.min(current, maximum), maximum = maximum }
	return result
end

function State.adjust(state, key, delta)
	if not State.labels[key] or not State.integer(delta) then return nil, "Invalid adjustment." end
	local result = State.copy(state)
	result[key].current = math.max(0, math.min(state[key].maximum, state[key].current + delta))
	return result
end

function State.adjustAmount(state, key, amount, direction)
	local number = State.integer(amount)
	if not number or number &lt; 1 or number &gt; State.limit or (direction ~= -1 and direction ~= 1) then
		return nil, "Enter an amount from 1 to 9999."
	end
	return State.adjust(state, key, number * direction)
end

function State.setMaximum(state, key, maximum)
	if not State.labels[key] then return nil, "Unknown resource." end
	return State.setResource(state, key, maximum, maximum)
end

function State.shiftPlate(state, delta)
	local result = State.copy(state)
	result.plateOffset = delta == 0 and 0 or math.clamp(result.plateOffset + delta, -3, 10)
	return result
end

function State.newTurn(state)
	local result = State.copy(state)
	result.ap.current = result.ap.maximum
	return result
end

function State.recoveryAmounts(manaValue, apValue)
	local mana, ap = State.integer(manaValue), State.integer(apValue)
	if mana == nil or ap == nil or mana &lt; 0 or ap &lt; 0 or mana &gt; State.limit or ap &gt; State.limit then
		return nil, "Enter mana and action recovery from 0 to 9999."
	end
	if mana == 0 and ap == 0 then return nil, "Set at least one recovery amount above zero." end
	return { mana = mana, ap = ap }
end

function State.recover(state, manaValue, apValue)
	local amounts, message = State.recoveryAmounts(manaValue, apValue)
	if not amounts then return nil, message end
	local result = State.copy(state)
	for _, key in ipairs({ "mana", "ap" }) do
		result[key].current = math.min(result[key].maximum, result[key].current + amounts[key])
	end
	return result
end

function State.restore(state)
	local result = State.copy(state)
	for _, key in ipairs(State.resources) do result[key].current = result[key].maximum end
	return result
end

function State.rename(state, text)
	local name = tostring(text):match("^%s*(.-)%s*$")
	local length = utf8.len(name)
	if not length or length &lt; 1 or length &gt; 48 or name:find("[%c]") then
		return nil, "Use a name with 1–48 characters and no line breaks."
	end
	local result = State.copy(state)
	result.name = name
	result.autoName = false
	return result
end

return State

end)()

local Names = (function()
-- Prefer an existing overhead name; never read our own generated plate.
local Names = {}

function Names.clean(text, richText)
	if type(text) ~= "string" then return nil end
	if richText then
		text = text:gsub("&lt;[^&gt;]*&gt;", "")
		text = text:gsub("&amp;lt;", "&lt;"):gsub("&amp;gt;", "&gt;"):gsub("&amp;quot;", '"'):gsub("&amp;apos;", "'"):gsub("&amp;amp;", "&amp;")
	end
	text = text:gsub("[%c]", " "):match("^%s*(.-)%s*$")
	local length = utf8.len(text)
	if not length or length == 0 then return nil end
	if length &gt; 48 then text = text:sub(1, utf8.offset(text, 49) - 1) end
	return text
end

function Names.isOwned(object, character)
	local cursor = object
	while cursor and cursor ~= character do
		if cursor:GetAttribute("CampaignLedgerOwned") == true then return true end
		cursor = cursor.Parent
	end
	return false
end

local function billboardFor(object, character)
	local cursor, billboard = object, nil
	while cursor and cursor ~= character do
		if cursor:IsA("GuiObject") and not cursor.Visible then return nil end
		if cursor:IsA("BillboardGui") then
			if not cursor.Enabled then return nil end
			billboard = cursor
		end
		cursor = cursor.Parent
	end
	if not billboard or Names.isOwned(object, character) then return nil end
	local adornee = billboard.Adornee
	if adornee and adornee ~= character and not adornee:IsDescendantOf(character) then return nil end
	return billboard
end

local function candidate(object, character)
	if not (object:IsA("TextLabel") or object:IsA("TextButton")) or object.TextTransparency &gt;= 1 then return nil end
	local gui = billboardFor(object, character)
	if not gui then return nil end
	local text = Names.clean(object.Text, object.RichText)
	if not text or not text:find("[^%d%p%s]") or text:find("%d%s*/%s*%d") then return nil end
	local id = string.lower(object.Name)
	local content = string.lower(text)
	for _, resource in ipairs({ "health", "mana", "actions", "hp", "mp", "ap", "level", "status" }) do
		if id == resource or id == resource .. "value" or content == resource
			or content:match("^" .. resource .. "%s*:") then return nil end
	end
	local score = math.min(object.TextSize, 40)
	if id:find("name", 1, true) then score += 100 end
	if string.lower(gui.Name):find("name", 1, true) then score += 50 end
	return text, score
end

function Names.resolve(character)
	local best, bestScore, bestPath
	for _, object in ipairs(character:GetDescendants()) do
		local text, score = candidate(object, character)
		if text then
			local path = object:GetFullName()
			if not bestScore or score &gt; bestScore or (score == bestScore and path &lt; bestPath) then
				best, bestScore, bestPath = text, score, path
			end
		end
	end
	if bestScore and bestScore &gt;= 50 then return best end
	local humanoid = character:FindFirstChildWhichIsA("Humanoid", true)
	if humanoid and humanoid.DisplayDistanceType.Name ~= "None" and humanoid.NameDisplayDistance &gt; 0 then
		return Names.clean(humanoid.DisplayName) or Names.clean(humanoid.Parent.Name) or "Character"
	end
	if best then return best end
	return Names.clean(character.Name) or "Character"
end

function Names.apply(character, state)
	if state.autoName == false then return state end
	-- Return a new view; reading the roster must never overwrite combat state.
	local result = table.clone(state)
	result.name = Names.resolve(character)
	return result
end

function Names.observe(character, callback)
	local listeners, watched = {}, {}
	local function watch(object)
		if Names.isOwned(object, character) or watched[object] then return end
		local properties
		if object:IsA("TextLabel") or object:IsA("TextButton") then
			properties = { "Text", "RichText", "Visible", "TextTransparency", "TextSize", "Name" }
		elseif object:IsA("BillboardGui") then
			properties = { "Enabled", "Adornee", "Name" }
		elseif object:IsA("Humanoid") then
			properties = { "DisplayName", "NameDisplayDistance", "DisplayDistanceType" }
		elseif object:IsA("GuiObject") then
			properties = { "Visible" }
		end
		if not properties then return end
		local group = {}
		for _, property in ipairs(properties) do
			table.insert(group, object:GetPropertyChangedSignal(property):Connect(callback))
		end
		watched[object] = group
	end
	for _, object in ipairs(character:GetDescendants()) do watch(object) end
	table.insert(listeners, character.DescendantAdded:Connect(function(object)
		if Names.isOwned(object, character) then return end
		watch(object)
		callback()
	end))
	table.insert(listeners, character.DescendantRemoving:Connect(function(object)
		if Names.isOwned(object, character) then return end
		if watched[object] then
			for _, listener in ipairs(watched[object]) do listener:Disconnect() end
			watched[object] = nil
		end
		callback()
	end))
	return { Disconnect = function()
		for _, listener in ipairs(listeners) do listener:Disconnect() end
		for _, group in pairs(watched) do for _, listener in ipairs(group) do listener:Disconnect() end end
	end }
end

return Names

end)()

local Registry = (function()
-- Persistent identity is separate from display names and combat values.
local Registry = {}
Registry.__index = Registry
Registry.idAttribute = "CampaignLedgerId"
Registry.tag = "CampaignLedgerCharacter"

function Registry.validId(value)
	return type(value) == "string" and #value == 36
		and value:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
end

function Registry.new(generate)
	return setmetatable({ generate = generate, owners = {} }, Registry)
end

function Registry:plan(characters)
	local present, owners, ids, updates, reserved = {}, {}, {}, {}, {}
	for _, character in ipairs(characters) do
		present[character] = true
		local id = character:GetAttribute(Registry.idAttribute)
		if Registry.validId(id) then reserved[id] = true end
	end
	-- Preserve the known original when a duplicate carrying its ID arrives first.
	for id, character in pairs(self.owners) do
		if present[character] and character:GetAttribute(Registry.idAttribute) == id then owners[id] = character end
	end
	for _, character in ipairs(characters) do
		local id = character:GetAttribute(Registry.idAttribute)
		if not Registry.validId(id) or (owners[id] and owners[id] ~= character) then
			repeat id = self.generate() until Registry.validId(id) and not reserved[id]
			reserved[id] = true
			table.insert(updates, { character = character, id = id })
		end
		owners[id], ids[character] = character, id
	end
	self.owners = owners
	return updates, ids
end

function Registry.character(candidate)
	-- A selected limb/accessory belongs to its containing rig, not a second token.
	local cursor, containingModel = candidate, nil
	while cursor and not cursor:IsA("Workspace") do
		if cursor:IsA("Model") then
			containingModel = containingModel or cursor
			if cursor:FindFirstChildOfClass("Humanoid") then return cursor end
		end
		cursor = cursor.Parent
	end
	if candidate:IsA("BasePart") and containingModel then candidate = containingModel end
	if not candidate:IsA("Model") then return candidate end
	local humanoid
	for _, object in ipairs(candidate:GetDescendants()) do
		if object:IsA("Humanoid") then
			if humanoid then return nil, "Select one character, not a group containing multiple humanoids." end
			humanoid = object
		end
	end
	-- Register the actual rig, so ungrouping an outer wrapper cannot erase its stats.
	if humanoid and humanoid.Parent:IsA("Model") then return humanoid.Parent end
	return candidate
end

function Registry.registeredAncestor(candidate, root)
	local result, cursor = nil, candidate
	while cursor and cursor ~= root do
		if cursor:HasTag(Registry.tag) then result = cursor end
		cursor = cursor.Parent
	end
	return result
end

function Registry.plateOwner(gui, root)
	local reference = gui:FindFirstChild("CampaignLedgerOwner")
	if reference and reference:IsA("ObjectValue") and reference.Value and reference.Value ~= root then return reference.Value end
	local parent = gui.Parent
	if parent and parent ~= root and (parent:IsA("Model") or parent:IsA("BasePart")) then return parent end
	local cursor = gui.Adornee
	while cursor and cursor ~= root do
		if cursor:HasTag(Registry.tag) then return Registry.registeredAncestor(cursor, root) end
		if cursor:IsA("Model") and cursor:FindFirstChildOfClass("Humanoid") then return cursor end
		cursor = cursor.Parent
	end
	return nil
end

return Registry

end)()

local Theme = (function()
local Theme = {}
-- Approved palette C: ash and burgundy. Surfaces and text have separate roles.
Theme.colors = {
	base = Color3.fromRGB(40, 32, 42),
	surface = Color3.fromRGB(60, 48, 59),
	field = Color3.fromRGB(75, 59, 72),
	text = Color3.fromRGB(238, 230, 225),
	muted = Color3.fromRGB(197, 181, 192),
	hp = Color3.fromRGB(231, 161, 161),
	mana = Color3.fromRGB(182, 190, 223),
	ap = Color3.fromRGB(218, 201, 176),
	line = Color3.fromRGB(133, 108, 125),
	track = Color3.fromRGB(40, 31, 40),
	accent = Color3.fromRGB(213, 161, 178),
	shell = Color3.fromRGB(37, 28, 37),
	edge = Color3.fromRGB(110, 85, 103),
	light = Color3.fromRGB(203, 188, 198),
	selection = Color3.fromRGB(100, 67, 79),
	active = Color3.fromRGB(107, 75, 90),
	enemyActive = Color3.fromRGB(112, 68, 75),
}
Theme.font = Enum.Font.SourceSans
Theme.bold = Enum.Font.SourceSansSemibold
Theme.display = Enum.Font.Garamond

function Theme.create(className, props, parent)
	local object = Instance.new(className)
	for key, value in pairs(props) do object[key] = value end
	object.Parent = parent
	return object
end

function Theme.stroke(parent, color)
	return Theme.create("UIStroke", { Color = color or Theme.colors.line, Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
end

function Theme.rule(parent, props)
	local settings = { Name = "Rule", BackgroundColor3 = Theme.colors.line,
		BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Active = false, Selectable = false }
	for key, value in pairs(props or {}) do settings[key] = value end
	return Theme.create("Frame", settings, parent)
end

-- Small square corner brackets mark the character sheet and dice result, not every control.
function Theme.corners(parent, color, length)
	local size = length or 7
	for _, corner in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
		local anchor = Vector2.new(corner[1], corner[2])
		local position = UDim2.fromScale(corner[1], corner[2])
		Theme.rule(parent, { Name = "CornerHorizontal", BackgroundColor3 = color or Theme.colors.line,
			AnchorPoint = anchor, Position = position, Size = UDim2.fromOffset(size, 1) })
		Theme.rule(parent, { Name = "CornerVertical", BackgroundColor3 = color or Theme.colors.line,
			AnchorPoint = anchor, Position = position, Size = UDim2.fromOffset(1, size) })
	end
end

function Theme.junction(parent, y)
	for _, side in ipairs({ { 0, 0 }, { 0.5, 12 } }) do
		Theme.rule(parent, { BackgroundColor3 = Theme.colors.edge,
			Position = UDim2.new(side[1], side[2], 0, y), Size = UDim2.new(0.5, -12, 0, 1) })
	end
	local diamond = Theme.create("Frame", { Name = "BindingJunction", BackgroundTransparency = 1,
		BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, y),
		Size = UDim2.fromOffset(5, 5), Rotation = 45, Active = false, Selectable = false }, parent)
	Theme.stroke(diamond, Theme.colors.light)
end

function Theme.enable(button, enabled)
	button:SetAttribute("ThemeEnabled", enabled)
	button.Active, button.Selectable, button.Interactable = enabled, enabled, enabled
	button.TextTransparency = enabled and 0 or 0.55
end

function Theme.label(parent, text, size, props)
	local settings = { BackgroundTransparency = 1, BorderSizePixel = 0, Text = text,
		TextColor3 = Theme.colors.text, TextSize = size or 16, Font = Theme.font,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 0, 24), RichText = false, Active = false, Selectable = false }
	for key, value in pairs(props or {}) do settings[key] = value end
	return Theme.create("TextLabel", settings, parent)
end

function Theme.select(button, selected, color)
	button:SetAttribute("ThemeSelected", selected)
	button:SetAttribute("ThemeSelectedColor", color or Theme.colors.active)
	button.BackgroundColor3 = selected and (color or Theme.colors.active) or button:GetAttribute("ThemeBackground")
	button.TextColor3 = selected and Theme.colors.text or button:GetAttribute("ThemeForeground")
	button:FindFirstChildOfClass("UIStroke").Color = Theme.colors.line
end

function Theme.button(parent, text, props)
	local settings = { BackgroundColor3 = Theme.colors.field, BorderSizePixel = 0,
		Text = text, TextColor3 = Theme.colors.text, TextSize = 16, Font = Theme.bold,
		AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 32), Selectable = true }
	for key, value in pairs(props or {}) do settings[key] = value end
	local button = Theme.create("TextButton", settings, parent)
	button:SetAttribute("ThemeBackground", settings.BackgroundColor3)
	button:SetAttribute("ThemeForeground", settings.TextColor3)
	local stroke = Theme.stroke(button)
	local hovered, focused = false, false
	local function paint()
		if button:GetAttribute("ThemeEnabled") == false then return end
		local selected = button:GetAttribute("ThemeSelected")
		local color = selected and button:GetAttribute("ThemeSelectedColor") or button:GetAttribute("ThemeBackground")
		button.BackgroundColor3 = hovered and color:Lerp(Theme.colors.text, 0.08) or color
		stroke.Color = (hovered or focused) and Theme.colors.accent or Theme.colors.line
	end
	button.MouseEnter:Connect(function() hovered = true; paint() end)
	button.MouseLeave:Connect(function() hovered = false; paint() end)
	button.SelectionGained:Connect(function() focused = true; paint() end)
	button.SelectionLost:Connect(function() focused = false; paint() end)
	return button
end

function Theme.input(parent, placeholder, props)
	local settings = { BackgroundColor3 = Theme.colors.field, BorderSizePixel = 0,
		Text = "", PlaceholderText = placeholder, PlaceholderColor3 = Theme.colors.muted,
		TextColor3 = Theme.colors.text, TextSize = 17, Font = Theme.font,
		ClearTextOnFocus = false, Size = UDim2.new(1, 0, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Left }
	for key, value in pairs(props or {}) do settings[key] = value end
	local input = Theme.create("TextBox", settings, parent)
	local stroke = Theme.stroke(input)
	Theme.create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, input)
	input.Focused:Connect(function() stroke.Color = Theme.colors.accent; stroke.Thickness = 2 end)
	input.FocusLost:Connect(function() stroke.Color = Theme.colors.line; stroke.Thickness = 1 end)
	return input
end

return Theme

end)()

local Layout = (function()
-- Only roster/editor scroll. Global combat controls never leave the widget.
local Layout = {}
Layout.editorPadding = 4
Layout.headingHeight = 48
Layout.selectButtonTop = 26
Layout.selectButtonHeight = 20
Layout.resourceHeight = 64
Layout.recoveryHeight = 104
Layout.minimumSplit = 256
Layout.editorBottom = 64
Layout.editorGap = 16
function Layout.split(height, requested, recoveryOpen)
 local minimum = Layout.minimumSplit + (recoveryOpen and Layout.recoveryHeight or 0)
 -- At normal height keep all three combat rows and the details disclosure in view.
 local maximum = math.max(minimum, height - 384)
 return math.clamp(requested, minimum, maximum)
end
function Layout.geometry(height, requested, recoveryOpen)
 local split = Layout.split(height, requested, recoveryOpen)
 return { split = split, search = 140 + (recoveryOpen and Layout.recoveryHeight or 0),
  roster = 174 + (recoveryOpen and Layout.recoveryHeight or 0),
  rosterHeight = split - 212 - (recoveryOpen and Layout.recoveryHeight or 0),
  register = split - 32, editor = split + Layout.editorGap,
  editorHeight = math.max(1, height - split - Layout.editorGap - Layout.editorBottom) }
end
return Layout

end)()

local Placement = (function()
-- World-space axis-aligned bounds, including arbitrary part rotation.
-- Snapshots use CFrame:GetComponents() and part Size; no engine globals needed.
local Placement = {}
Placement.width = 3.8
Placement.height = 3.8 * 116 / 228

function Placement.bounds(parts)
	local lowX, lowY, lowZ = math.huge, math.huge, math.huge
	local highX, highY, highZ = -math.huge, -math.huge, -math.huge
	for _, part in ipairs(parts) do
		local c = part.transform
		local x, y, z = part.sx / 2, part.sy / 2, part.sz / 2
		local ex = math.abs(c[4]) * x + math.abs(c[5]) * y + math.abs(c[6]) * z
		local ey = math.abs(c[7]) * x + math.abs(c[8]) * y + math.abs(c[9]) * z
		local ez = math.abs(c[10]) * x + math.abs(c[11]) * y + math.abs(c[12]) * z
		lowX, highX = math.min(lowX, c[1] - ex), math.max(highX, c[1] + ex)
		lowY, highY = math.min(lowY, c[2] - ey), math.max(highY, c[2] + ey)
		lowZ, highZ = math.min(lowZ, c[3] - ez), math.max(highZ, c[3] + ez)
	end
	if #parts == 0 then return nil end
	return { x = (lowX + highX) / 2, y = (lowY + highY) / 2, z = (lowZ + highZ) / 2,
		top = highY, height = highY - lowY }
end

function Placement.plateCenter(top, nameTop)
	-- Keep the bottom of our plate above the existing name region, not over it.
	local bottom = math.max(top + 0.2, nameTop or -math.huge) + 0.15
	return bottom + Placement.height / 2
end
return Placement

end)()

local Turn = (function()
local Turn = {}
Turn.attribute = "CampaignLedgerTurn"
function Turn.isActive(value)
	return value == "party" or value == "enemy"
end
function Turn.view(value)
	if value == "party" then return "Party turn", "Your party can act.", "mana" end
	if value == "enemy" then return "Enemy turn", "Wait while the enemies act.", "hp" end
	if value == nil or value == "idle" then return "No active combat", "Waiting for the DM to begin.", "muted" end
	return "Turn unavailable", "Ask the DM to set Party turn or Enemy turn.", "muted"
end
return Turn

end)()

local HoverRules = (function()
-- Pure hit resolution and visibility rules, independent of Roblox services.
local HoverRules = {}
function HoverRules.character(target, root, registered)
 local cursor, result = target, nil
 while cursor and cursor ~= root do
  if registered[cursor] then result = cursor end
  cursor = cursor.Parent
 end
 return result
end

function HoverRules.prefer(candidate, current)
 if not current then return true end
 local a = candidate:GetAttribute("CampaignLedgerPlateId")
 local b = current:GetAttribute("CampaignLedgerPlateId")
 return type(a) == "string" and (type(b) ~= "string" or a &lt; b)
end

function HoverRules.skipHit(part)
 return part and part:IsA("BasePart") and ((part.Transparency or 0) &gt;= 0.95 or (part.LocalTransparencyModifier or 0) &gt;= 0.95)
end

function HoverRules.movementBase(part, character)
 if not part:IsA("BasePart") then return false end
 local cursor = part
 while cursor and cursor ~= character do
  local override = cursor:GetAttribute("CampaignLedgerIgnoreHover")
  if type(override) == "boolean" then return override end
  cursor = cursor.Parent
 end
 -- A stand is a very thin, horizontal part below the rest of a multi-part
 -- figure. Never infer this for a standalone flat token or a body accessory.
 if not character:IsA("Model") or part.Parent ~= character or not part.Size or not part.CFrame then return false end
 local size, frame = part.Size, part.CFrame
 local height = math.abs(frame.RightVector.Y) * size.X + math.abs(frame.UpVector.Y) * size.Y + math.abs(frame.LookVector.Y) * size.Z
 if height &gt; math.max(size.X, size.Y, size.Z) * 0.12 then return false end
 local above = false
 for _, other in ipairs(character:GetDescendants()) do
  if other ~= part and other:IsA("BasePart") and other.Transparency &lt; 0.95 then
   if other.Position.Y &lt; part.Position.Y then return false end
   if other.Position.Y &gt; part.Position.Y + height then above = true end
  end
 end
 return above
end
function HoverRules.visible(hoverOnly, permitted, owner, hovered)
 return permitted == true and owner ~= nil and (not hoverOnly or owner == hovered)
end
function HoverRules.viewportPoint(x, y, left, top, width, height, viewportWidth, viewportHeight)
 if width &lt;= 0 or height &lt;= 0 or viewportWidth &lt;= 0 or viewportHeight &lt;= 0 then return nil end
 local u, v = (x - left) / width, (y - top) / height
 if u &lt; 0 or v &lt; 0 or u &gt;= 1 or v &gt;= 1 then return nil end
 return u * viewportWidth, v * viewportHeight
end
return HoverRules

end)()

local Hover = (function()
local Rules = HoverRules
local Hover = {}
local ROOT = "CampaignLedgerLocalPlates"
local SETTING = "CampaignLedgerHoverOnly"
local VISIBLE_SETTING = "CampaignLedgerPlatesVisible"
local TAG = "CampaignLedgerGeneratedPlate"
local CHARACTER_TAG = "CampaignLedgerCharacter"

local function createController(plugin, onChanged)
 local core = game:GetService("CoreGui")
 local world = game:GetService("Workspace")
 local collection = game:GetService("CollectionService")
 local run = game:GetService("RunService")
 local input = game:GetService("UserInputService")
 local ok, saved = pcall(function() return plugin:GetSetting(SETTING) end)
 local hoverOnly = not (ok and saved == false)
 local visibleOK, savedVisible = pcall(function() return plugin:GetSetting(VISIBLE_SETTING) end)
 local platesVisible = not (visibleOK and savedVisible == false)
 local root, owner, sensor, rootConnection
 local copies, registered, tracked, links, movementBases = {}, {}, {}, {}, {}
 local mouseX, mouseY, inside, focused, elapsed = 0, 0, false, true, 0
 local alive = true
 local update
 local rayParams = RaycastParams.new()
 rayParams.FilterType = Enum.RaycastFilterType.Exclude
 rayParams.IgnoreWater = true
 local function preferenceChanged()
  hoverOnly = root:GetAttribute("HoverOnly") ~= false
  platesVisible = root:GetAttribute("PlatesVisible") ~= false
  pcall(function() plugin:SetSetting(SETTING, hoverOnly) end)
  pcall(function() plugin:SetSetting(VISIBLE_SETTING, platesVisible) end)
  if onChanged then onChanged(hoverOnly) end
  if owner and update then update() end
 end
 local function attach()
  local current = core:FindFirstChild(ROOT)
  if current and current:GetAttribute("CampaignLedgerOwned") ~= true then return false end
  if current then
   local leader = current:FindFirstChild("OwnerPlugin")
   if not leader or not leader.Value then current:Destroy(); current = nil end
  end
  if not current then
   current = Instance.new("Folder"); current.Name = ROOT
   current:SetAttribute("CampaignLedgerOwned", true); current:SetAttribute("HoverOnly", hoverOnly)
   current:SetAttribute("PlatesVisible", platesVisible)
   local reference = Instance.new("ObjectValue"); reference.Name = "OwnerPlugin"; reference.Value = plugin; reference.Parent = current
   current.Parent = core
  end
  if root ~= current then
   if rootConnection then for _, connection in ipairs(rootConnection) do connection:Disconnect() end end
   root = current
   owner = root.OwnerPlugin.Value == plugin
   rootConnection = {
    root:GetAttributeChangedSignal("HoverOnly"):Connect(preferenceChanged),
    root:GetAttributeChangedSignal("PlatesVisible"):Connect(preferenceChanged),
   }
   preferenceChanged()
   if owner then
    copies, registered, tracked = {}, {}, {}
    local screen = Instance.new("ScreenGui"); screen.Name = "HoverSurface"
    screen.IgnoreGuiInset = true; screen.ResetOnSpawn = false; screen.DisplayOrder = -10; screen.Parent = root
    sensor = Instance.new("Frame"); sensor.Name = "ViewportPointer"
    sensor.BackgroundTransparency = 1; sensor.BorderSizePixel = 0; sensor.Active = false
    sensor.Selectable = false; sensor.Size = UDim2.fromScale(1, 1); sensor.Parent = screen
    local function moved(x, y)
     mouseX, mouseY, inside = x, y, true
     if update then update() end
    end
    table.insert(links, sensor.MouseEnter:Connect(moved))
    table.insert(links, sensor.MouseMoved:Connect(moved))
    table.insert(links, sensor.MouseLeave:Connect(function() inside = false; if update then update() end end))
   end
  end
  return owner
 end
 local function sync()
  registered, tracked, movementBases = {}, {}, {}
  local present, chosen = {}, {}
  for _, character in ipairs(collection:GetTagged(CHARACTER_TAG)) do
   if character:IsDescendantOf(world) then registered[character] = true end
  end
  for character in pairs(registered) do
   for _, part in ipairs(character:GetDescendants()) do
    if part:IsA("BasePart") and Rules.movementBase(part, character) then movementBases[part] = true end
   end
  end
  for _, template in ipairs(collection:GetTagged(TAG)) do
   if template:IsA("BillboardGui") and template:IsDescendantOf(world)
    and template:GetAttribute("CampaignLedgerLocalTemplate") == true then
    local reference = template:FindFirstChild("CampaignLedgerOwner")
    local character = reference and reference.Value
    if character and character:IsDescendantOf(world) and character:HasTag(CHARACTER_TAG)
     and Rules.character(character, world, registered) == character then
     if Rules.prefer(template, chosen[character]) then chosen[character] = template end
    end
   end
  end
  for character, template in pairs(chosen) do
     present[template], tracked[template] = true, character
     local copy = copies[template]
     if copy then
      local sourceName = template:FindFirstChild("CharacterName", true)
      local localName = copy:FindFirstChild("CharacterName", true)
      if sourceName and localName and sourceName.Text ~= localName.Text then localName.Text = sourceName.Text end
     end
  end
  for template, copy in pairs(copies) do
   if not present[template] then copy:Destroy(); copies[template] = nil end
  end
 end
 update = function()
  local hovered
  local camera = world.CurrentCamera
  if platesVisible and hoverOnly and inside and focused and camera and sensor and sensor.Visible then
   local pos, size, viewport = sensor.AbsolutePosition, sensor.AbsoluteSize, camera.ViewportSize
   -- Read the current pointer each sample so coalesced GUI events cannot leave
   -- the ray one mouse move behind. The passive surface still gates viewport exit.
   local pointer = input:GetMouseLocation()
   mouseX, mouseY = pointer.X, pointer.Y
   local x, y = Rules.viewportPoint(mouseX, mouseY, pos.X, pos.Y, size.X, size.Y, viewport.X, viewport.Y)
   if x then
    local ray = camera:ViewportPointToRay(x, y)
    local excluded = {}
    for _ = 1, 32 do
     rayParams.FilterDescendantsInstances = excluded
     local hit = world:Raycast(ray.Origin, ray.Direction * 10000, rayParams)
     if not hit or not Rules.skipHit(hit.Instance) then
      hovered = hit and not movementBases[hit.Instance] and Rules.character(hit.Instance, world, registered) or nil; break
     end
     table.insert(excluded, hit.Instance)
    end
   end
  end
  for template, character in pairs(tracked) do
   local visible = Rules.visible(hoverOnly, platesVisible and template:GetAttribute("CampaignLedgerPlateVisible"), character, hovered)
   local copy = copies[template]
   if visible and not copy then
    copy = template:Clone()
    collection:RemoveTag(copy, TAG)
    copy.Name = "Character_" .. tostring(character:GetAttribute("CampaignLedgerId"))
    copy:SetAttribute("CampaignLedgerLocalCopy", true)
    copy.Active = false
    for _, child in ipairs(copy:GetDescendants()) do
     if child:IsA("GuiObject") then child.Active = false; child.Selectable = false end
    end
    copy.Enabled = false; copy.Parent = root; copies[template] = copy
   end
   if copy then copy.Enabled = visible end
  end
 end
 local dirty, syncElapsed = true, 0
 table.insert(links, collection:GetInstanceAddedSignal(TAG):Connect(function() dirty = true end))
 table.insert(links, collection:GetInstanceRemovedSignal(TAG):Connect(function() dirty = true end))
 table.insert(links, input.WindowFocusReleased:Connect(function() focused = false; inside = false; if owner then update() end end))
 table.insert(links, input.WindowFocused:Connect(function() focused = true end))
 table.insert(links, run.Heartbeat:Connect(function(dt)
  if not alive then return end
  elapsed += dt; syncElapsed += dt
  if elapsed &lt; 1 / 60 then return end
  elapsed = 0
  if not attach() then return end
  if dirty or syncElapsed &gt;= 0.2 then dirty = false; syncElapsed = 0; sync() end
  update()
 end))
 attach()
 local controller = {}
 function controller:getHoverOnly() return hoverOnly end
 function controller:getPlatesVisible() return platesVisible end
 function controller:setPlatesVisible(value)
  attach()
  if root then root:SetAttribute("PlatesVisible", value == true) end
 end
 function controller:setHoverOnly(value)
  attach()
  if root then root:SetAttribute("HoverOnly", value == true) end
 end
 function controller:destroy()
  if not alive then return end
  alive = false
  if rootConnection then for _, connection in ipairs(rootConnection) do connection:Disconnect() end end
  for _, link in ipairs(links) do link:Disconnect() end
  if owner and root and root.Parent then root:Destroy() end
 end
 return controller
end
-- A combined plugin has one owner Instance; its features share one renderer.
local leases = {}
function Hover.start(plugin, onChanged)
 local entry = leases[plugin]
 if not entry then
  entry = { listeners = {} }
  leases[plugin] = entry
  entry.controller = createController(plugin, function(value)
   for _, callback in pairs(entry.listeners) do if callback then callback(value) end end
  end)
 end
 local lease, alive = {}, true
 entry.listeners[lease] = onChanged or false
 if onChanged then onChanged(entry.controller:getHoverOnly()) end
 function lease:getHoverOnly() return entry.controller:getHoverOnly() end
 function lease:getPlatesVisible() return entry.controller:getPlatesVisible() end
 function lease:setPlatesVisible(value) if alive then entry.controller:setPlatesVisible(value) end end
 function lease:setHoverOnly(value) if alive then entry.controller:setHoverOnly(value) end end
 function lease:destroy()
  if not alive then return end
  alive = false
  entry.listeners[self] = nil
  if next(entry.listeners) == nil then
   leases[plugin] = nil
   entry.controller:destroy()
  end
 end
 return lease
end
return Hover

end)()

local Plate = (function()
local Theme = Theme
local Placement = Placement
local Names = Names
local State = State
local Registry = Registry
local CollectionService = game:GetService("CollectionService")
local Plate = {}
Plate.name = "CampaignLedgerPlate"
Plate.tag = "CampaignLedgerGeneratedPlate"
Plate.styleVersion = 12
local C = Theme.colors

-- Convert the design's reference pixels to relative layout once. Roblox handles
-- camera-distance scaling natively, without per-frame place writes in Team Create.
local function scaleLayout(parent, width, height)
	for _, object in ipairs(parent:GetChildren()) do
		if object:IsA("GuiObject") then
			local size, position = object.Size, object.Position
			local childWidth = size.X.Scale * width + size.X.Offset
			local childHeight = size.Y.Scale * height + size.Y.Offset
			object.Size = UDim2.fromScale(childWidth / width, childHeight / height)
			object.Position = UDim2.fromScale(position.X.Scale + position.X.Offset / width,
				position.Y.Scale + position.Y.Offset / height)
			if object:IsA("TextLabel") then
				object.TextScaled = true
				Theme.create("UITextSizeConstraint", { MinTextSize = 1, MaxTextSize = object.TextSize }, object)
			end
			scaleLayout(object, math.max(childWidth, 1), math.max(childHeight, 1))
		end
	end
end

function Plate.head(character)
	if not character:IsA("Model") then return nil end
	local head = character:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then return head end
	local candidate, volume = nil, -1
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Transparency &lt; 1 and string.lower(part.Name):match("head$") then
			local size = part.Size
			local value = size.X * size.Y * size.Z
			if value &gt; volume then candidate, volume = part, value end
		end
	end
	return candidate
end

function Plate.anchor(character)
	if character:IsA("BasePart") then return character end
	if not character:IsA("Model") then return nil end
	local head = Plate.head(character)
	if head then return head end
	if character.PrimaryPart then return character.PrimaryPart end
	local largest, volume = nil, -1
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			local size = part.Size
			local candidate = size.X * size.Y * size.Z
			if part.Transparency &lt; 1 and candidate &gt; volume then largest, volume = part, candidate end
		end
	end
	return largest or character:FindFirstChildWhichIsA("BasePart", true)
end

function Plate.bounds(character)
	local parts = character:IsA("BasePart") and { character } or character:GetDescendants()
	-- Human rigs use their head rather than a raised weapon or tall accessory.
	local head = Plate.head(character)
	if head then parts = { head } end
	local visible, all = {}, {}
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") then
			local snapshot = { sx = part.Size.X, sy = part.Size.Y, sz = part.Size.Z, transform = { part.CFrame:GetComponents() } }
			table.insert(all, snapshot)
			if part.Transparency &lt; 1 then table.insert(visible, snapshot) end
		end
	end
	return Placement.bounds(#visible &gt; 0 and visible or all)
end

local function existingNameTop(character, bounds)
	local humanoid = character:FindFirstChildWhichIsA("Humanoid", true)
	local nativeName = humanoid and humanoid.DisplayDistanceType.Name ~= "None" and humanoid.NameDisplayDistance &gt; 0
	local highest = bounds.top + (nativeName and 1.4 or 0.2)
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BillboardGui") and object.Enabled and not Names.isOwned(object, character) then
			local target = object.Adornee or object.Parent
			local position = target:IsA("Attachment") and target.WorldPosition or target:IsA("BasePart") and target.Position
			if position then
				local halfHeight = object.Size.Y.Scale / 2
				-- Pixel-based existing name labels need a little additional clearance.
				local pixelAllowance = object.Size.Y.Offset &gt; 0 and 1 or 0
				local top = position.Y + object.StudsOffsetWorldSpace.Y + object.StudsOffset.Y
					+ math.abs(object.ExtentsOffsetWorldSpace.Y) * bounds.height / 2 + halfHeight + pixelAllowance
				highest = math.max(highest, top)
			end
		end
	end
	return highest
end

function Plate.list(character)
	local result, seen = {}, {}
	local candidates = CollectionService:GetTagged(Plate.tag)
	for _, child in ipairs(character:GetDescendants()) do
		if child:IsA("BillboardGui") then table.insert(candidates, child) end
	end
	for _, gui in ipairs(candidates) do
		if not seen[gui] and gui:IsA("BillboardGui") and gui.Name == Plate.name
			and gui:GetAttribute("CampaignLedgerOwned") == true and Plate.owner(gui) == character then
			seen[gui] = true; table.insert(result, gui)
		end
	end
	return result
end

function Plate.get(character)
	local primary
	for _, gui in ipairs(Plate.list(character)) do
		local id, previous = gui:GetAttribute("CampaignLedgerPlateId"), primary and primary:GetAttribute("CampaignLedgerPlateId")
		if not primary or (type(id) == "string" and (type(previous) ~= "string" or id &lt; previous)) then primary = gui end
	end
	return primary
end

function Plate.owner(gui)
	return Registry.plateOwner(gui, workspace)
end

function Plate.recoverState(gui)
	local label = gui:FindFirstChild("CharacterName", true)
	local name = label and Names.clean(label.Text)
	if not name then return nil end
	local state = State.default(name)
	state.showPlate = gui:GetAttribute("CampaignLedgerPlateVisible")
	if state.showPlate == nil then state.showPlate = gui.Enabled end
	for _, key in ipairs(State.resources) do
		local value = gui:FindFirstChild(key .. "Value", true)
		local current, maximum
		if value then current, maximum = value.Text:match("^(%d+)%s*/%s*(%d+)$") end
		if not current or not maximum then return nil end
		state[key] = { current = tonumber(current), maximum = tonumber(maximum) }
	end
	return State.validate(state) and state or nil
end

function Plate.clearAnchors(character, keep)
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("Attachment") and object.Name == "CampaignLedgerAnchor"
			and object:GetAttribute("CampaignLedgerOwned") == true and object ~= keep then
			local cursor = object.Parent
			while cursor and cursor ~= character and not cursor:HasTag(Registry.tag) do cursor = cursor.Parent end
			if cursor == character then object:Destroy() end
		end
	end
end

function Plate.clear(character)
	for _, gui in ipairs(Plate.list(character)) do gui:Destroy() end
	Plate.clearAnchors(character)
end

function Plate.prune(character)
	local primary = Plate.get(character)
	-- New complete plates have a shared unique key. Every editor keeps the same
	-- winner even when concurrent Team Create edits arrive in a different order.
	if not primary or type(primary:GetAttribute("CampaignLedgerPlateId")) ~= "string" then return end
	for _, gui in ipairs(Plate.list(character)) do if gui ~= primary then gui:Destroy() end end
	Plate.clearAnchors(character, primary.Adornee)
end

function Plate.render(character, state)
	local anchor = Plate.anchor(character)
	assert(anchor, "Character needs a Head, PrimaryPart or another BasePart.")
	Plate.clear(character)
	local bounds = assert(Plate.bounds(character), "Character has no geometry.")
	local humanoid = character:FindFirstChildWhichIsA("Humanoid", true)
	local standardHead = character:IsA("Model") and character:FindFirstChild("Head", true)
	local human = humanoid and standardHead and standardHead:IsA("BasePart")
	-- An attachment at the geometry's centre follows the model even when its Head
	-- is sideways, off-centre, or absent (for example a dog or a single mesh token).
	local attachment = Theme.create("Attachment", { Name = "CampaignLedgerAnchor",
		Position = anchor.CFrame:PointToObjectSpace(Vector3.new(bounds.x, human and bounds.y or bounds.top, bounds.z)) }, nil)
	attachment:SetAttribute("CampaignLedgerOwned", true)
	attachment.Parent = anchor
	-- Build while unparented; collaborators see a complete persisted plate.
	local gui = Theme.create("BillboardGui", {
		Name = Plate.name, Adornee = attachment, Size = UDim2.fromScale(Placement.width, Placement.height),
		AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 160,
		Enabled = false, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, nil)
	gui:SetAttribute("CampaignLedgerOwned", true)
	gui:SetAttribute("CampaignLedgerPlateId", game:GetService("HttpService"):GenerateGUID(false))
	gui:SetAttribute("CampaignLedgerLocalTemplate", true)
	gui:SetAttribute("CampaignLedgerPlateVisible", state.showPlate)
	gui:SetAttribute("CampaignLedgerStyleVersion", Plate.styleVersion)
	gui:SetAttribute(Registry.idAttribute, character:GetAttribute(Registry.idAttribute))
	local owner = Theme.create("ObjectValue", { Name = "CampaignLedgerOwner", Value = character }, gui)
	owner:SetAttribute("CampaignLedgerOwned", true)
	CollectionService:AddTag(gui, Plate.tag)
	if human then
		gui.StudsOffsetWorldSpace = Vector3.new(0, Placement.plateCenter(bounds.top, existingNameTop(character, bounds)) - bounds.y + (state.plateOffset or 0), 0)
	else
		-- Camera-relative clearance keeps low animal/token plates above their head
		-- in the image, including when the DM looks steeply down at the table.
		gui.StudsOffsetWorldSpace = Vector3.new(0, math.max(0, existingNameTop(character, bounds) - bounds.top - 0.2), 0)
		gui.StudsOffset = Vector3.new(0, Placement.height / 2 + 0.65 + (state.plateOffset or 0), 0)
	end
	local canvas = Theme.create("Frame", { Name = "Canvas", BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0 }, gui)
	Theme.create("UISizeConstraint", { MinSize = Vector2.zero, MaxSize = Vector2.new(228, 116) }, canvas)
	local body = Theme.create("Frame", { Name = "Plate", BackgroundColor3 = C.surface,
		BackgroundTransparency = 0, BorderSizePixel = 0, Size = UDim2.new(1, -2, 1, -6),
		Position = UDim2.fromOffset(1, 1) }, canvas)
	Theme.stroke(body, C.edge)
	Theme.corners(body, C.accent, 8)
	local nameBand = Theme.create("Frame", { Name = "NameBand", BackgroundColor3 = C.shell, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26) }, body)
	Theme.rule(nameBand, { BackgroundColor3 = C.line, Position = UDim2.new(0, 5, 1, 0), Size = UDim2.new(1, -10, 0, 1) })
	Theme.label(nameBand, state.name, 19, { Name = "CharacterName", Font = Theme.display,
		Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 23),
		TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Center })
	for index, key in ipairs({ "hp", "mana" }) do
		local resource = state[key]
		local y = 32 + (index - 1) * 26
		Theme.label(body, key == "hp" and "Health" or "Mana", 13, {
			Position = UDim2.fromOffset(12, y), Size = UDim2.fromOffset(47, 18), TextColor3 = C[key] })
		Theme.label(body, resource.current .. " / " .. resource.maximum, 14, {
			Name = key .. "Value", Font = Theme.bold, Position = UDim2.new(1, -82, 0, y),
			Size = UDim2.fromOffset(70, 18), TextXAlignment = Enum.TextXAlignment.Right })
		local track = Theme.create("Frame", { Name = key .. "Track", BackgroundColor3 = C.track,
			BorderSizePixel = 0, Position = UDim2.fromOffset(61, y + 5), Size = UDim2.fromOffset(79, 6) }, body)
		Theme.stroke(track, C.line)
		local fraction = resource.maximum == 0 and 0 or resource.current / resource.maximum
		local fill = Theme.create("Frame", { Name = "Fill", BackgroundColor3 = C[key], BorderSizePixel = 0,
			Size = UDim2.fromScale(fraction, 1) }, track)
	end
	Theme.label(body, "Actions", 13, { Position = UDim2.fromOffset(12, 87),
		Size = UDim2.fromOffset(47, 18), TextColor3 = C.ap })
	local ap = state.ap
	if ap.maximum &lt;= 10 then
		for index = 1, ap.maximum do
			local pip = Theme.create("Frame", { Name = "Action" .. index,
				BackgroundColor3 = index &lt;= ap.current and C.ap or C.track, BorderSizePixel = 0,
				Size = UDim2.fromOffset(6, 6), Position = UDim2.fromOffset(63 + (index - 1) * 8, 94),
				Rotation = 45 }, body)
		end
	else
		Theme.label(body, "Available", 12, { Position = UDim2.fromOffset(61, 87),
			Size = UDim2.fromOffset(79, 18), TextColor3 = C.muted })
	end
	Theme.label(body, ap.current .. " / " .. ap.maximum, 14, { Name = "apValue", Font = Theme.bold,
		Position = UDim2.new(1, -82, 0, 87), Size = UDim2.fromOffset(70, 18),
		TextXAlignment = Enum.TextXAlignment.Right })
	scaleLayout(canvas, 228, 116)
	gui.Parent = character
	return gui
end

return Plate

end)()

local Panel = (function()
local Theme = Theme
local State = State
local Layout = Layout
local Turn = Turn
local Panel = {}
Panel.__index = Panel
local C = Theme.colors

local function frame(parent, props)
 local values = { BackgroundTransparency = 1, BorderSizePixel = 0 }
 for key, value in pairs(props or {}) do values[key] = value end
 return Theme.create("Frame", values, parent)
end
local function stack(parent, gap)
 Theme.create("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, parent)
end

function Panel.new(widget, actions)
 local self = setmetatable({ actions = actions, fields = {}, rows = {}, turnButtons = {}, connections = {}, expanded = false }, Panel)
 self.viewport = frame(widget, { Name = "LedgerViewport", BackgroundTransparency = 0,
  BackgroundColor3 = C.shell, Size = UDim2.fromScale(1, 1) })
 self.root = frame(self.viewport, { Name = "CampaignLedger", Size = UDim2.fromScale(1, 1) })
 Theme.label(self.root, "Campaign Ledger", 28, { Font = Theme.display, TextColor3 = C.text,
  Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 32), TextXAlignment = Enum.TextXAlignment.Center })
 local binding = frame(self.root, { Position = UDim2.fromOffset(12, 44), Size = UDim2.new(1, -24, 0, 1) })
 Theme.junction(binding, 0)
 self.turnRow = frame(self.root, { Name = "CombatTurn", Position = UDim2.fromOffset(12, 50), Size = UDim2.new(1, -24, 0, 84) })
 self.turnTitle = Theme.label(self.turnRow, "No active combat", 14, { Font = Theme.bold, TextColor3 = C.light,
  Size = UDim2.new(1, 0, 0, 18) })
 for index, spec in ipairs({ { "Party turn", "party" }, { "Enemy turn", "enemy" }, { "End combat", "idle" } }) do
  local button = Theme.button(self.turnRow, spec[1], { Name = "Turn_" .. spec[2],
   BackgroundColor3 = C.shell, TextColor3 = C.text, Position = UDim2.new((index - 1) / 3, (index - 1) * 2, 0, 24),
   Size = UDim2.new(1 / 3, -4, 0, 28), TextSize = 14 })
  button.Activated:Connect(function() actions.setTurn(spec[2]) end)
  self.turnButtons[spec[2]] = button
 end
 self.recoveryToggle = Theme.button(self.turnRow, "+ Recovery", { Name = "RecoveryToggle", TextSize = 14,
  TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = C.shell, TextColor3 = C.light,
  Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 26) })
 Theme.create("UIPadding", { PaddingLeft = UDim.new(0, 8) }, self.recoveryToggle)
 self.recovery = frame(self.root, { Name = "Recovery", Visible = false, BackgroundTransparency = 0,
  BackgroundColor3 = C.surface, Position = UDim2.fromOffset(12, 138), Size = UDim2.new(1, -24, 0, 96) })
 local recovery = actions.loadRecovery()
 for index, spec in ipairs({ { "Mana to add", "mana" }, { "AP to add", "ap" } }) do
  Theme.label(self.recovery, spec[1], 14, { Font = Theme.bold, TextColor3 = C[spec[2]],
   Position = UDim2.new((index - 1) / 2, 8, 0, 4), Size = UDim2.new(0.5, -16, 0, 18) })
 end
 self.manaRecovery = Theme.input(self.recovery, "0–9999", { Name = "ManaRecovery", Text = tostring(recovery.mana),
  Position = UDim2.fromOffset(8, 24), Size = UDim2.new(0.5, -12, 0, 26) })
 self.apRecovery = Theme.input(self.recovery, "0–9999", { Name = "ActionRecovery", Text = tostring(recovery.ap),
  Position = UDim2.new(0.5, 4, 0, 24), Size = UDim2.new(0.5, -12, 0, 26) })
 for index, spec in ipairs({ { "Recover selected", false }, { "Recover all models", true } }) do
  local button = Theme.button(self.recovery, spec[1], { Name = spec[2] and "RecoverAll" or "RecoverSelected",
   Position = UDim2.new((index - 1) / 2, index == 1 and 8 or 4, 0, 54),
   Size = UDim2.new(0.5, -12, 0, 26), TextSize = 14 })
  button.Activated:Connect(function() actions.recover(self.manaRecovery.Text, self.apRecovery.Text, spec[2]) end)
  if spec[2] then self.recoverAll = button else self.recoverSelected = button end
 end
 Theme.label(self.recovery, "Manual recovery · caps at maximum · 0 skips", 13, { TextColor3 = C.muted,
  Position = UDim2.fromOffset(8, 80), Size = UDim2.new(1, -16, 0, 16) })
 self.search = Theme.input(self.root, "Search characters…", { Position = UDim2.fromOffset(12, 140), Size = UDim2.new(1, -24, 0, 28) })
 self.search:GetPropertyChangedSignal("Text"):Connect(function() self:drawRoster() end)
 self.roster = Theme.create("ScrollingFrame", { Name = "CharacterRoster", BackgroundColor3 = C.surface, BorderSizePixel = 0,
  Position = UDim2.fromOffset(12, 174), Size = UDim2.new(1, -24, 0, 130), CanvasSize = UDim2.new(),
  AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
  ScrollBarThickness = 3, ScrollBarImageColor3 = C.ap }, self.root)
 Theme.stroke(self.roster, C.edge)
 stack(self.roster, 2)
 self.register = Theme.button(self.root, "+ Register selected model", { Name = "RegisterCharacter", BackgroundColor3 = C.shell, TextColor3 = C.text, TextSize = 14 })
 self.register.Activated:Connect(actions.register)
 self.divider = Theme.create("TextButton", { Name = "RosterDivider", Text = "", AutoButtonColor = false,
  BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, -24, 0, 12), Selectable = false }, self.root)
 Theme.rule(self.divider, { Position = UDim2.fromOffset(0, 5) })
 frame(self.divider, { BackgroundTransparency = 0, BackgroundColor3 = C.shell,
  Position = UDim2.new(0.5, -27, 0, 0), Size = UDim2.fromOffset(54, 12) })
 for _, x in ipairs({ -16, -4, 8 }) do
  Theme.rule(self.divider, { BackgroundColor3 = C.muted, Position = UDim2.new(0.5, x, 0, 4), Size = UDim2.fromOffset(8, 2) })
 end
 self.editor = Theme.create("ScrollingFrame", { Name = "CharacterEditor", BackgroundColor3 = C.surface, BorderSizePixel = 0,
  CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
  ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = C.ap }, self.root)
 Theme.stroke(self.editor, C.edge)
 Theme.corners(self.editor, C.light, 9)
 self.content = frame(self.editor, { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
 Theme.create("UIPadding", { PaddingTop = UDim.new(0, Layout.editorPadding), PaddingBottom = UDim.new(0, 8),
  PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 4) }, self.content)
 stack(self.content, 6)
 self.empty = Theme.label(self.content, "Select a model and register it to begin.", 17, { LayoutOrder = 0,
  TextColor3 = C.muted, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, Size = UDim2.new(1, 0, 0, 70) })
 self.heading = frame(self.content, { Size = UDim2.new(1, 0, 0, Layout.headingHeight), LayoutOrder = 1 })
 local nameBand = frame(self.heading, { Name = "CharacterHeading", BackgroundTransparency = 0,
  BackgroundColor3 = C.surface, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 24) })
 self.title = Theme.label(nameBand, "", 22, { Name = "SelectedCharacterName", Font = Theme.display, TextColor3 = C.text,
  Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0) })
 Theme.button(self.heading, "Select model in map", { Name = "SelectModel", BackgroundColor3 = C.surface, Position = UDim2.new(0, 0, 0, Layout.selectButtonTop),
  Size = UDim2.fromOffset(140, Layout.selectButtonHeight), TextSize = 13 }).Activated:Connect(actions.selectModel)
 Theme.label(self.heading, "Custom amount ↓", 12, { TextColor3 = C.muted, Position = UDim2.new(0.5, 0, 0, 26),
  Size = UDim2.new(0.5, 0, 0, 20) })
 for index, key in ipairs(State.resources) do
  local row = frame(self.content, { Name = key .. "Combat", LayoutOrder = index + 1, Size = UDim2.new(1, 0, 0, Layout.resourceHeight) })
  Theme.label(row, State.labels[key], 16, { Font = Theme.bold, TextColor3 = C[key], Size = UDim2.new(1, -158, 0, 24) })
  local current = Theme.label(row, "", 24, { Name = key .. "Current", Font = Theme.bold,
   Position = UDim2.new(1, -150, 0, -1), Size = UDim2.fromOffset(82, 26), TextXAlignment = Enum.TextXAlignment.Right })
  local maximum = Theme.label(row, "", 15, { Name = key .. "Maximum", TextColor3 = C.muted,
   Position = UDim2.new(1, -64, 0, 2), Size = UDim2.fromOffset(64, 22), TextXAlignment = Enum.TextXAlignment.Right })
  local track = frame(row, { Name = key .. "Track", BackgroundTransparency = 0, BackgroundColor3 = C.track,
   Position = UDim2.fromOffset(0, 27), Size = UDim2.new(1, 0, 0, 4) })
  Theme.stroke(track)
  local fill = frame(track, { Name = "Fill", BackgroundTransparency = 0, BackgroundColor3 = C[key], Size = UDim2.fromScale(1, 1) })
  local presets = frame(row, { Position = UDim2.fromOffset(0, 36), Size = UDim2.new(0.5, -6, 0, 28) })
  local specs = key == "ap" and { { "−1", -1 }, { "+1", 1 }, { "Refill AP", 0 } }
   or { { "−5", -5 }, { "−1", -1 }, { "+1", 1 }, { "+5", 5 } }
  for i, spec in ipairs(specs) do
   Theme.button(presets, spec[1], { Name = key .. "Preset" .. i,
    Position = UDim2.new(key == "ap" and (i == 3 and 0.5 or (i - 1) * 0.25) or (i - 1) / #specs, 0, 0, 0),
    Size = UDim2.new(key == "ap" and (i == 3 and 0.5 or 0.25) or 1 / #specs, -3, 1, 0),
    TextSize = key == "ap" and 12 or 15 }).Activated:Connect(function()
     if key == "ap" and spec[2] == 0 then actions.newTurn() else actions.adjust(key, spec[2]) end
    end)
  end
  local amount = Theme.input(row, "Amt", { Name = key .. "Amount", Text = "1", TextSize = 15,
   TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0.5, 0, 0, 36), Size = UDim2.new(0.13, -2, 0, 28) })
  -- Narrow numeric wells need all four digits, without the usual text padding.
  local padding = amount:FindFirstChildOfClass("UIPadding")
  padding.PaddingLeft, padding.PaddingRight = UDim.new(0, 1), UDim.new(0, 1)
  Theme.button(row, "Subtract", { Name = key .. "Subtract", Position = UDim2.new(0.63, 3, 0, 36),
   Size = UDim2.new(0.23, -5, 0, 28), TextSize = 13 }).Activated:Connect(function() actions.adjustAmount(key, amount.Text, -1) end)
  Theme.button(row, "Add", { Name = key .. "Add", Position = UDim2.new(0.86, 2, 0, 36),
   Size = UDim2.new(0.14, -2, 0, 28), TextSize = 13 }).Activated:Connect(function() actions.adjustAmount(key, amount.Text, 1) end)
  self.fields[key] = { row = row, current = current, summaryMaximum = maximum, fill = fill, amount = amount }
 end
 self.advancedToggle = Theme.button(self.content, "+ Character details · maximums &amp; settings", { Name = "CharacterDetails", LayoutOrder = 6, TextSize = 14, Size = UDim2.new(1, 0, 0, 28) })
 self.advanced = frame(self.content, { LayoutOrder = 7, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Visible = false })
 stack(self.advanced, 12)
 self.advancedToggle.Activated:Connect(function()
  self.expanded = not self.expanded
  self.advanced.Visible = self.expanded and self.selected ~= nil
  self.advancedToggle.Text = self.expanded and "− Character details · maximums &amp; settings" or "+ Character details · maximums &amp; settings"
 end)
 for index, key in ipairs(State.resources) do
  local row = frame(self.advanced, { LayoutOrder = index, Size = UDim2.new(1, 0, 0, 62) })
  Theme.label(row, State.labels[key] .. " maximum", 16, { Font = Theme.bold, TextColor3 = C[key], Size = UDim2.new(1, 0, 0, 21) })
  local maximum = Theme.input(row, "Maximum", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, -80, 0, 34) })
  local function save() actions.setMaximum(key, maximum.Text) end
  Theme.button(row, "Save", { Position = UDim2.new(1, -70, 0, 26), Size = UDim2.fromOffset(70, 34) }).Activated:Connect(save)
  maximum.FocusLost:Connect(function(enter) if enter then save() end end)
  self.fields[key].maximum = maximum
 end
 Theme.button(self.advanced, "Restore all resources", { LayoutOrder = 4 }).Activated:Connect(actions.restore)
 local nameRow = frame(self.advanced, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 62) })
 Theme.label(nameRow, "Character name", 14, { TextColor3 = C.muted })
 self.nameInput = Theme.input(nameRow, "Character name", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, -80, 0, 34) })
 local function rename() actions.rename(self.nameInput.Text) end
 Theme.button(nameRow, "Save", { Position = UDim2.new(1, -70, 0, 26), Size = UDim2.fromOffset(70, 34) }).Activated:Connect(rename)
 self.nameInput.FocusLost:Connect(function(enter) if enter then rename() end end)
 self.autoName = Theme.button(self.advanced, "Use a manual name", { LayoutOrder = 6, TextSize = 15 })
 self.autoName.Activated:Connect(actions.toggleAutoName)
 self.visibility = Theme.button(self.advanced, "Hide overhead plate", { LayoutOrder = 7, TextSize = 15 })
 self.visibility.Activated:Connect(actions.togglePlate)
 local heightRow = frame(self.advanced, { LayoutOrder = 8, Size = UDim2.new(1, 0, 0, 60) })
 self.heightLabel = Theme.label(heightRow, "Plate height: auto", 16)
 for index, spec in ipairs({ { "Lower", -0.25 }, { "Auto", 0 }, { "Raise", 0.25 } }) do
  Theme.button(heightRow, spec[1], { Position = UDim2.new((index - 1) / 3, 0, 0, 27), Size = UDim2.new(1 / 3, -5, 0, 30),
   TextSize = 15 }).Activated:Connect(function() actions.shiftPlate(spec[2]) end)
 end
 Theme.button(self.advanced, "Rebuild overhead plate", { LayoutOrder = 9, TextSize = 15 }).Activated:Connect(actions.rebuild)
 Theme.button(self.advanced, "Remove from ledger", { LayoutOrder = 10, TextSize = 15,
  TextColor3 = C.muted }).Activated:Connect(actions.remove)
 Theme.label(self.advanced, "Saving a maximum refills that resource. Studio Undo reverts edits.", 14, {
  LayoutOrder = 11, TextColor3 = C.muted, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, Size = UDim2.new(1, 0, 0, 42) })
 self.hoverToggle = Theme.button(self.root, "Hover plates: On", { Name = "HoverPreference", BackgroundColor3 = C.shell,
  TextColor3 = C.light, Position = UDim2.new(0, 12, 1, -60), Size = UDim2.new(1, -24, 0, 26), TextSize = 14 })
 self.hoverToggle.Activated:Connect(actions.toggleHoverOnly)
 self.footer = Theme.label(self.root, "Type an amount, then Subtract or Add.", 13, { TextColor3 = C.light,
  TextWrapped = true, TextTruncate = Enum.TextTruncate.None, Position = UDim2.new(0, 12, 1, -30), Size = UDim2.new(1, -24, 0, 28) })
 self.split = actions.loadDivider() or Layout.minimumSplit
 local function layout()
  local height = math.max(480, self.viewport.AbsoluteSize.Y)
  local extra = self.recoveryOpen and Layout.recoveryHeight or 0
  local geometry = Layout.geometry(height, self.split + extra, self.recoveryOpen)
  self.split = geometry.split - extra
  self.search.Position = UDim2.fromOffset(12, geometry.search)
  self.roster.Position = UDim2.fromOffset(12, geometry.roster)
  self.roster.Size = UDim2.new(1, -24, 0, geometry.rosterHeight)
  self.register.Position, self.register.Size = UDim2.fromOffset(12, geometry.register), UDim2.new(1, -24, 0, 28)
  self.divider.Position = UDim2.fromOffset(12, geometry.split)
  self.editor.Position = UDim2.fromOffset(12, geometry.editor)
  self.editor.Size = UDim2.new(1, -24, 0, geometry.editorHeight)
 end
 table.insert(self.connections, self.viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout))
 self.recoveryToggle.Activated:Connect(function()
  self.recoveryOpen = not self.recoveryOpen
  self.recovery.Visible = self.recoveryOpen
  self.recoveryToggle.Text = self.recoveryOpen and "− Recovery" or "+ Recovery"
  layout()
 end)
 local dragStartY, dragStartSplit
 local detector = Theme.create("UIDragDetector", { DragStyle = Enum.UIDragDetectorDragStyle.TranslateLine,
  DragAxis = Vector2.new(0, 1), ResponseStyle = Enum.UIDragDetectorResponseStyle.CustomOffset }, self.divider)
 local function moveDivider(position)
  if dragStartY then
   self.split = dragStartSplit + position.Y - dragStartY
   layout()
  end
 end
 local function stopDrag()
  dragStartY, dragStartSplit = nil, nil
  actions.saveDivider(self.split)
 end
 self.stopDrag = stopDrag
 detector.DragStart:Connect(function(position)
  dragStartY, dragStartSplit = position.Y, self.split
 end)
 detector.DragContinue:Connect(moveDivider)
 detector.DragEnd:Connect(function(position) moveDivider(position); stopDrag() end)
 table.insert(self.connections, widget.WindowFocusReleased:Connect(stopDrag))
 layout()
 self:refresh({}, nil, nil)
 return self
end

function Panel:updateHoverOnly(value)
 self.hoverToggle.Text = value and "Hover plates: On · this window" or "Hover plates: Off · this window"
 Theme.select(self.hoverToggle, value, C.active)
end
function Panel:notify(message, isError)
 self.footer.Text, self.footer.TextColor3 = (isError and "Error: " or "") .. message, isError and C.hp or C.light
end
function Panel:updateTurn(value)
 local title = Turn.view(value)
 self.turnTitle.Text, self.turnTitle.TextColor3 = title, C.text
 for side, button in pairs(self.turnButtons) do
  Theme.select(button, side == value and side ~= "idle", side == "party" and C.active or C.enemyActive)
 end
end
function Panel:destroy()
 self.stopDrag()
 for _, connection in ipairs(self.connections) do connection:Disconnect() end
 self.viewport:Destroy()
end
function Panel:drawRoster()
 for _, row in ipairs(self.rows) do row:Destroy() end
 self.rows = {}
 local query, shown = string.lower(self.search.Text), 0
 for _, entry in ipairs(self.entries or {}) do
  local name = entry.state and entry.state.name or entry.character.Name
  if query == "" or string.find(string.lower(name), query, 1, true) then
   shown += 1
   local active = entry.character == self.selected
   local button = Theme.create("TextButton", { Name = "Character_" .. (entry.id or tostring(shown)), Text = "", BorderSizePixel = 0,
    BackgroundColor3 = active and C.selection or C.field, BackgroundTransparency = active and 0 or 0.65,
    AutoButtonColor = false, Size = UDim2.new(1, -5, 0, 42), LayoutOrder = shown, Selectable = true }, self.roster)
   if active then frame(button, { BackgroundTransparency = 0, BackgroundColor3 = C.accent,
    Size = UDim2.new(0, 3, 1, 0) }) end
   Theme.label(button, name, 18, { Font = Theme.display, TextColor3 = C.text,
    Position = UDim2.fromOffset(10, 1), Size = UDim2.new(1, -42, 0, 24) })
   if active then Theme.label(button, "›", 24, { TextColor3 = C.text, Font = Theme.bold,
    Position = UDim2.new(1, -25, 0, 4), Size = UDim2.fromOffset(20, 28), TextXAlignment = Enum.TextXAlignment.Center }) end
   if entry.state then
    for index, key in ipairs(State.resources) do
     local label = key == "ap" and "AP" or State.labels[key]
     Theme.label(button, label .. " " .. entry.state[key].current, 13, { TextColor3 = active and C.text or C[key],
      Position = UDim2.new((index - 1) / 3, 10, 0, 23), Size = UDim2.new(1 / 3, -12, 0, 18) })
    end
   else
    Theme.label(button, "Stats need repair", 13, { TextColor3 = C.hp,
     Position = UDim2.fromOffset(10, 23), Size = UDim2.new(1, -20, 0, 18) })
   end
   button.Activated:Connect(function() self.actions.choose(entry.character) end)
   local function highlight(value) button.BackgroundTransparency = active and 0 or value and 0 or 0.65 end
   button.MouseEnter:Connect(function() highlight(true) end)
   button.MouseLeave:Connect(function() highlight(false) end)
   button.SelectionGained:Connect(function() highlight(true) end)
   button.SelectionLost:Connect(function() highlight(false) end)
   table.insert(self.rows, button)
  end
 end
 if shown == 0 then table.insert(self.rows, Theme.label(self.roster,
  query == "" and "No characters registered yet." or "No matching characters.", 15,
  { TextColor3 = C.muted, Size = UDim2.new(1, -5, 0, 38) })) end
end
function Panel:refresh(entries, selected, state)
 local changed = self.selected ~= selected
 self.entries, self.selected = entries, selected
 self:drawRoster()
 local visible = state ~= nil
 Theme.enable(self.recoverSelected, visible)
 self.recoverAll.Text = "Recover all (" .. #entries .. ")"
 self.empty.Visible, self.heading.Visible, self.advancedToggle.Visible = not visible, visible, visible
 self.advanced.Visible = visible and self.expanded
 for _, fields in pairs(self.fields) do fields.row.Visible = visible end
 self.empty.Text = selected and "This character has invalid stats. Use Studio Undo to recover its last valid values."
  or "Select a model in the map, then click Register selected model. Already registered? Choose it in the roster above."
 if not state then return end
 self.title.Text = state.name
 for key, fields in pairs(self.fields) do
  fields.current.Text = tostring(state[key].current)
  fields.summaryMaximum.Text = "/ " .. state[key].maximum
  fields.fill.Size = UDim2.fromScale(state[key].maximum == 0 and 0 or state[key].current / state[key].maximum, 1)
  if changed or not fields.maximum:IsFocused() then fields.maximum.Text = tostring(state[key].maximum) end
  if changed then fields.amount.Text = "1" end
 end
 if changed or not self.nameInput:IsFocused() then self.nameInput.Text = state.name end
 self.autoName.Text = state.autoName ~= false and "Use a manual name" or "Use model’s overhead name"
 self.visibility.Text = state.showPlate and "Hide overhead plate" or "Show overhead plate"
 self.heightLabel.Text = "Plate height: " .. ((state.plateOffset or 0) == 0 and "auto" or string.format("%+.2f studs", state.plateOffset))
 if changed then self.editor.CanvasPosition = Vector2.zero end
end
return Panel

end)()

local Dice = (function()
local Dice = {}
function Dice.roll(random, mode, modifier)
	modifier = tonumber(modifier)
	if not modifier or modifier ~= modifier or math.abs(modifier) &gt; 9999 or modifier % 1 ~= 0 then
		return nil, "Enter a whole-number modifier from −9999 to 9999."
	end
	if mode ~= "normal" and mode ~= "advantage" and mode ~= "disadvantage" then return nil, "Choose a roll mode." end
	local first = random:NextInteger(1, 20)
	local second = mode ~= "normal" and random:NextInteger(1, 20) or nil
	local natural = first
	if mode == "advantage" then natural = math.max(first, second) end
	if mode == "disadvantage" then natural = math.min(first, second) end
	return { first = first, second = second, natural = natural, modifier = modifier, total = natural + modifier, mode = mode }
end
function Dice.describe(roll)
	local dice = tostring(roll.first)
	if roll.second then dice ..= ", " .. roll.second .. "; kept " .. roll.natural end
	local sign = roll.modifier &lt; 0 and " − " or " + "
	return "D20 " .. dice .. sign .. math.abs(roll.modifier) .. " = " .. roll.total
end
return Dice

end)()

local DicePanel = (function()
local Theme = Theme
local Dice = Dice
local C = Theme.colors
local DicePanel = {}
function DicePanel.new(widget, random)
local viewport = Theme.create("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.shell,
	BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 3, ScrollBarImageColor3 = C.light, ScrollingDirection = Enum.ScrollingDirection.Y }, widget)
local root = Theme.create("Frame", { Name = "D20Roller", BorderSizePixel = 0, BackgroundColor3 = C.shell,
	Size = UDim2.new(1, -4, 0, 453) }, viewport)
Theme.label(root, "D20 Roller", 26, { Font = Theme.display, TextColor3 = C.text,
	Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -24, 0, 34), TextXAlignment = Enum.TextXAlignment.Center })
local binding = Theme.create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 48), Size = UDim2.new(1, -24, 0, 1) }, root)
Theme.junction(binding, 0)
Theme.label(root, "Modifier", 16, { TextColor3 = C.text, Position = UDim2.fromOffset(12, 64), Size = UDim2.new(1, -112, 0, 32) })
local modifier = Theme.input(root, "+0", { Name = "Modifier", Text = "0", TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.new(1, -100, 0, 64), Size = UDim2.fromOffset(88, 32) })
local well = Theme.create("Frame", { Name = "RollResult", BackgroundColor3 = C.field, BorderSizePixel = 0,
	Position = UDim2.fromOffset(12, 113), Size = UDim2.new(1, -24, 0, 142) }, root)
Theme.stroke(well)
Theme.corners(well, C.accent, 12)
local result = Theme.label(well, "—", 64, { Name = "Total", Font = Theme.bold, TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 72) })
local detail = Theme.label(well, "Roll when you’re ready.", 16, { Name = "Breakdown", TextWrapped = true,
	TextTruncate = Enum.TextTruncate.None, TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromOffset(12, 78), Size = UDim2.new(1, -24, 0, 32) })
local natural = Theme.label(well, "", 18, { Name = "NaturalRoll", Font = Theme.bold, TextColor3 = C.accent,
	TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(12, 114), Size = UDim2.new(1, -24, 0, 24) })
local rollButton = Theme.button(root, "Roll D20", { Name = "RollD20", BackgroundColor3 = C.active, TextColor3 = C.text,
	Position = UDim2.fromOffset(12, 267), Size = UDim2.new(1, -24, 0, 40), TextSize = 20 })
Theme.rule(root, { Position = UDim2.fromOffset(12, 319), Size = UDim2.new(1, -24, 0, 1) })
Theme.label(root, "Recent rolls", 17, { Font = Theme.bold, TextColor3 = C.text, Position = UDim2.fromOffset(12, 329), Size = UDim2.new(1, -24, 0, 24) })
local history = Theme.create("ScrollingFrame", { Name = "RollHistory", BackgroundTransparency = 1, BorderSizePixel = 0,
	Position = UDim2.fromOffset(12, 359), Size = UDim2.new(1, -24, 0, 82), CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
	ScrollBarThickness = 3, ScrollBarImageColor3 = C.light }, root)
Theme.create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, history)
local historyRows = {}
local function drawHistory(recent)
	for _, row in ipairs(historyRows) do row:Destroy() end
	historyRows = {}
	if #recent == 0 then
		table.insert(historyRows, Theme.label(history, "No rolls yet.", 14, { TextColor3 = C.light }))
	end
	for index, value in ipairs(recent) do
		local row = Theme.label(history, Dice.describe(value), 14, {
			Name = "RecentRoll" .. index, TextColor3 = index == 1 and C.text or C.light,
			Font = index == 1 and Theme.bold or Theme.font, TextWrapped = true, TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = index,
			Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		table.insert(historyRows, row)
	end
	history.CanvasPosition = Vector2.zero
end
local recent = {}
drawHistory(recent)
local function roll()
	local value, message = Dice.roll(random, "normal", modifier.Text)
	if not value then detail.Text = message; detail.TextColor3 = C.hp; return end
	result.Text = tostring(value.total)
	detail.Text, detail.TextColor3 = Dice.describe(value), C.text
	natural.Text = value.natural == 20 and "Natural 20" or value.natural == 1 and "Natural 1" or ""
	table.insert(recent, 1, value)
	if #recent &gt; 5 then table.remove(recent) end
	drawHistory(recent)
end
rollButton.Activated:Connect(roll)
modifier.FocusLost:Connect(function(enter) if enter then roll() end end)
 return viewport
end
return DicePanel

end)()

